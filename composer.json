{
    "name": "josrom/laravel-logger",
    "description": "ChannelLog: Custom logger to laravel",
    "authors": [
        {
            "name": "Jose Vicente",
            "email": "jvortsromero@gmail.com"
        }
    ],
    "support": {
        "email": "jvortsromero@gmail.com"
    },
    "keywords": ["logging", "laravel"],
    "license": "MIT",
    "type": "library",
    "version": "12.0.0",
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "Laravel\\ChannelLog\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Laravel\\ChannelLog\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.2",
        "laravel/framework": "12.*",
        "guzzlehttp/guzzle": "7.*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.4",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.0"
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "format": "vendor/bin/php-cs-fixer fix"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
